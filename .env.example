# Copy this file to .env and fill in your broker credentials.
# The app runs fine with none of these set - it will fall back to DEMO mode
# with simulated data so you can see the dashboard working immediately.

# --- Zerodha Kite Connect ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- Dhan (DhanHQ) ---
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
